{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "sourceMap": false,
    "strict": true,
    "noImplicitAny": false,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "composite": true,
    "incremental": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": true,
    "paths": {
      "@application": ["./src/main/core/application/Application"],
      "@astra-api/provider-registry": ["./packages/provider-registry/src/index.ts"],
      "@astra-api/provider-registry/node": ["./packages/provider-registry/src/registry-loader.ts"],
      "@data/*": ["./src/main/data/*"],
      "@logger": ["./src/main/core/logger/LoggerService"],
      "@main/*": ["./src/main/*"],
      "@modelcontextprotocol/sdk/*": ["./node_modules/@modelcontextprotocol/sdk/dist/esm/*"],
      "@shared/*": ["./src/shared/*"],
      "@astra-api/ai-core": ["./packages/aiCore/src"],
      "@astra-api/ai-core/*": ["./packages/aiCore/src/*"],
      "@astra-api/ai-core/provider": ["./packages/aiCore/src/core/providers"],
      "@astra-api/ai-core/built-in/plugins": ["./packages/aiCore/src/core/plugins/built-in"],
      "@astra-api/ai-sdk-provider": ["./packages/ai-sdk-provider/src"],
      "@astra-api/ai-sdk-provider/*": ["./packages/ai-sdk-provider/src/*"],
      "@test-helpers/*": ["./tests/helpers/*"],
      "@test-mocks/*": ["./tests/__mocks__/*"]
    },
    "tsBuildInfoFile": ".tsbuildinfo/tsconfig.node.tsbuildinfo",
    "types": ["electron-vite/node", "vitest/globals"]
  },
  "include": [
    "electron.vite.config.*",
    "scripts",
    "src/main/**/*",
    "src/main/env.d.ts",
    "src/preload/**/*",
    "packages/provider-registry/**/*",
    "packages/aiCore/src/**/*",
    "packages/ai-sdk-provider/src/**/*",
    "src/shared/**/*",
    "tests/__mocks__/**/*",
    "tests/helpers/**/*"
  ],
  "exclude": ["packages/aiCore/src/**/__tests__", "packages/aiCore/test_utils"]
}
